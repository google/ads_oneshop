load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//build:extract_proto_descriptors.bzl", "extract_proto_descriptors")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "extract_descriptors_lib",
    srcs = ["extract_descriptors.py"],
    deps = [
        "@acit_deps//absl_py",
        "@acit_deps//protobuf",
    ],
)

py_binary(
    name = "extract_descriptors",
    srcs = ["extract_descriptors.py"],
    deps = [":extract_descriptors_lib"],
)

py_binary(
    name = "gapic_py_pb2_generator",
    srcs = ["gapic_py_pb2_generator.py"],
)

extract_proto_descriptors(
    name = "merchant_api_descriptor_set",
    out = "merchant_api.descriptor_set",
    packages = [
        "google.shopping.merchant_accounts_v1",
        "google.shopping.merchant_products_v1",
        "google.shopping.merchant_promotions_v1",
        "google.shopping.type",
    ],
    deps = [
        "@acit_deps//google_shopping_merchant_accounts",
        "@acit_deps//google_shopping_merchant_products",
        "@acit_deps//google_shopping_merchant_promotions",
        "@acit_deps//google_shopping_type",
    ],
)

py_test(
    name = "descriptor_registration_test",
    srcs = ["descriptor_registration_test.py"],
    data = [
        ":merchant_api_descriptor_set",
    ],
    main = "descriptor_registration_test.py",
    deps = [
        "//acit/api/v0:schema_py_pb2",
        "@acit_deps//absl_py",
        "@acit_deps//protobuf",
        "@rules_python//python/runfiles",
    ],
)
