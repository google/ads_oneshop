load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")

package(default_visibility = ["//visibility:public"])

py_proto_library(
    name = "bq_schema_py_pb2",
    deps = ["@protoc_gen_bq_schema//:protos_proto"],
)

genrule(
    name = "schema_pb2_gen",
    srcs = [
        "storage/schema.proto",
        "@protoc_gen_bq_schema//:protos_proto",
        "@protobuf//:descriptor_proto",
        "//build:merchant_api.descriptor_set",
    ],
    outs = [
        "storage/schema_pb2.py",
    ],
    cmd = """
        $(location //build:gapic_py_pb2_generator) \
            --protoc=$(location @toolchains_protoc_hub.linux_x86_64//:bin/protoc) \
            --proto_path=. \
            --descriptor_set_in=$(location @protoc_gen_bq_schema//:protos_proto):$(location @protobuf//:descriptor_proto):$(location //build:merchant_api.descriptor_set) \
            --proto_file=$(location storage/schema.proto) \
            --out_dir=$(BINDIR) \
            --target_py=$(location storage/schema_pb2.py) \
            --gapic_packages=google.shopping.merchant_accounts_v1,google.shopping.merchant_products_v1,google.shopping.merchant_promotions_v1,google.shopping.type \
            --gapic_prefixes=google.shopping.,google.type.
    """,
    tools = [
        "//build:gapic_py_pb2_generator",
        "@toolchains_protoc_hub.linux_x86_64//:bin/protoc",
    ],
)

py_library(
    name = "schema_py_pb2",
    srcs = [":schema_pb2_gen"],
    deps = [
        ":bq_schema_py_pb2",
        "@acit_deps//google_shopping_merchant_accounts",
        "@acit_deps//google_shopping_merchant_products",
        "@acit_deps//google_shopping_merchant_promotions",
        "@acit_deps//google_shopping_type",
        "@acit_deps//protobuf",
    ],
)

run_binary(
    name = "bq_gen_schemas",
    srcs = [
        # The tool has to be declared
        "//:protoc_gen_bq_schema",
        # We can't use -I, so we have to pass these instead
        "@protoc_gen_bq_schema//:protos_proto",
        "@protobuf//:descriptor_proto",
        # The file we actually want to process
        ":storage/schema.proto",
        # Extracted Google APIs descriptor set from GAPIC
        "//build:merchant_api.descriptor_set",
    ],
    outs = [
        "storage/Products.schema",
        "storage/accounts.schema",
        "storage/liasettings.schema",
        "storage/shippingsettings.schema",
        "storage/programs.schema",
        "storage/returns.schema",
        "storage/promotions.schema",
        "storage/reports.schema",
    ],
    args = [
        # alias the plugin because names are hard
        "--plugin=protoc-gen-bq-schema=$(location //:protoc_gen_bq_schema)",
        # magic output directory string
        "--bq-schema_out=bazel-out/k8-fastbuild/bin/",
        "--bq-schema_opt=enum-as-string",
        "--proto_path=acit/api/v0",
        "--descriptor_set_in=" +
        "$(location @protoc_gen_bq_schema//:protos_proto):" +
        "$(location @protobuf//:descriptor_proto):" +
        "$(location //build:merchant_api.descriptor_set)",
        "$(location :storage/schema.proto)",
    ],
    # Reuse the existing precompiled protoc
    tool = "@toolchains_protoc_hub.linux_x86_64//:bin/protoc",
)
